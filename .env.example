# External GPT backend only. Copy this file to .env and set your own key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional authentication for a separately hosted vLLM endpoint.
VLLM_API_KEY=
# Optional distinct embedding API credentials (otherwise use local CPU embeddings).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
